# =============================================================================
# Project Collaboration Platform — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#
#   cp .env.example .env
#
# All variables have sensible defaults for local development.
# Lines starting with # are comments and ignored.
# =============================================================================


# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string (main database)
DATABASE_URL=postgresql://collab:collab@localhost:5434/project_collaboration


# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001


# =============================================================================
# JWT Authentication
# =============================================================================

# Secret key for signing JWT tokens.
# !! CHANGE THIS IN PRODUCTION — use a random string of >= 32 characters !!
JWT_SECRET=dev-secret-change-me-in-production

# Signing algorithm (HS256 is the default; RS256 requires a key pair)
JWT_ALGORITHM=HS256

# Token lifetime in minutes
JWT_EXPIRE_MINUTES=60


# =============================================================================
# OAuth Providers (all optional — leave empty to disable a provider)
# =============================================================================
# Each provider follows the naming convention:
#
#   OAUTH_<PROVIDER>_CLIENT_ID
#   OAUTH_<PROVIDER>_CLIENT_SECRET
#   OAUTH_<PROVIDER>_REDIRECT_URI
#
# To enable a provider:
#   1. Register an app in the provider's developer console
#   2. Set the redirect URI to http://localhost:5173/oauth/callback (dev)
#      or https://yourdomain.com/oauth/callback (prod)
#   3. Fill in the credentials below

# --- Google ---
# Console: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=

# --- GitHub (coming soon) ---
# Console: https://github.com/settings/developers
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=

# --- Microsoft (coming soon) ---
# Console: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_REDIRECT_URI=

# --- Discord (coming soon) ---
# Console: https://discord.com/developers/applications
# OAUTH_DISCORD_CLIENT_ID=
# OAUTH_DISCORD_CLIENT_SECRET=
# OAUTH_DISCORD_REDIRECT_URI=
