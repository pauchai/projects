# =============================================================================
# Project Collaboration Platform — Environment Variables
# =============================================================================
#
# This project uses a split-env approach for Docker deployments:
#
#   .env.common  — shared variables (DB name, JWT algorithm, etc.)
#   .env.dev     — development overrides (weak passwords, HTTP URLs)
#   .env.prod    — production overrides (strong passwords, HTTPS, domain)
#
# The helper scripts (scripts/dev-start.sh, scripts/prod-deploy.sh) merge
# .env.common + .env.{dev|prod} into a temporary .env.temp file automatically.
#
# For local development WITHOUT Docker, copy this file to .env:
#
#   cp .env.example .env
#
# =============================================================================


# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string (for running outside Docker)
DATABASE_URL=postgresql://collab:collab@localhost:5434/project_collaboration

# Docker Compose variables (used inside containers)
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab
POSTGRES_DB=project_collaboration


# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://app.localhost


# =============================================================================
# JWT Authentication
# =============================================================================

# Secret key for signing JWT tokens.
# !! CHANGE THIS IN PRODUCTION — use: python -c "import secrets; print(secrets.token_urlsafe(48))" !!
JWT_SECRET=dev-secret-change-me-in-production

# Signing algorithm (HS256 is the default)
JWT_ALGORITHM=HS256

# Token lifetime in minutes
JWT_EXPIRE_MINUTES=60


# =============================================================================
# OAuth Providers (all optional — leave empty to disable a provider)
# =============================================================================

# --- Google ---
# Console: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# --- Telegram ---
# Create a bot via @BotFather on Telegram.
# Use SEPARATE bots for dev and prod environments.
OAUTH_TELEGRAM_BOT_TOKEN=
OAUTH_TELEGRAM_BOT_USERNAME=

# --- GitHub (coming soon) ---
# Console: https://github.com/settings/developers
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=

# --- Microsoft (coming soon) ---
# Console: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_REDIRECT_URI=

# --- Discord (coming soon) ---
# Console: https://discord.com/developers/applications
# OAUTH_DISCORD_CLIENT_ID=
# OAUTH_DISCORD_CLIENT_SECRET=
# OAUTH_DISCORD_REDIRECT_URI=


# =============================================================================
# Production-only (used in .env.prod)
# =============================================================================

# Your domain name (e.g., example.com)
# DOMAIN=example.com

# Email for Let's Encrypt certificate notifications
# ACME_EMAIL=admin@example.com
