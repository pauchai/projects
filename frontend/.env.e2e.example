# E2E environment variables
#
# Usage:
#   cp frontend/.env.e2e.example frontend/.env.e2e
#   # edit .env.e2e to match your setup, then just run:
#   cd frontend && npm run test:e2e
#
# .env.e2e is git-ignored (local per developer).
# Variables already set in the shell always take priority over this file.
# All variables are optional — the defaults work for a local setup where
# the backend and frontend run directly on the host.
#
# ─────────────────────────────────────────────────────────────────────────────
# Profile 1: local (default — comment everything out or delete the file)
# ─────────────────────────────────────────────────────────────────────────────
#   Backend :  python -m uvicorn project_collaboration.api.app:app --port 8000
#   Frontend:  cd frontend && npm run dev        (Playwright starts it automatically)
#   DB       :  docker compose --profile test up -d postgres-test
#
# E2E_BACKEND_URL=http://localhost:8000
# E2E_FRONTEND_URL=http://localhost:5173
# E2E_DATABASE_URL=postgresql://collab_test:collab_test@localhost:5433/project_collaboration_test

# ─────────────────────────────────────────────────────────────────────────────
# Profile 2: Docker dev stack with Traefik (app.localhost)
# ─────────────────────────────────────────────────────────────────────────────
#   Start stack:  docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
#   postgres-test is still exposed on localhost:5433 so DATABASE_URL stays the same.
#
E2E_BACKEND_URL=http://app.localhost/api
E2E_FRONTEND_URL=http://app.localhost
# E2E_DATABASE_URL=postgresql://collab_test:collab_test@localhost:5433/project_collaboration_test
